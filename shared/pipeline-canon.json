{
  "version": "human-first-v2",
  "description": "Research → Title → Writer(meaning) → Sol(style) → Description → Cover||Schema → Cover-QA → Indexer → Publish",
  "pipeline_agents_count": 18,
  "pipeline_agents": [
    "excalibur-blog-setup",
    "excalibur-blog-setup-voice",
    "excalibur-blog-setup-visual",
    "excalibur-blog-director",
    "excalibur-blog-scout",
    "excalibur-blog-research",
    "excalibur-blog-title",
    "excalibur-blog-writer",
    "excalibur-blog-sol",
    "excalibur-blog-description",
    "excalibur-blog-cover-text",
    "excalibur-blog-schema",
    "excalibur-blog-cover",
    "excalibur-blog-cover-qa",
    "excalibur-blog-indexer",
    "excalibur-blog-publish",
    "excalibur-blog-fixer",
    "excalibur-blog-content-learner"
  ],
  "description_agent": "excalibur-blog-description",
  "description_output": "description-brief.json",
  "description_rules": "shared/dzen-description-rules.md",
  "dzen_news_casus_rules": "shared/dzen-news-casus.md",
  "cover_qa_agent": "excalibur-blog-cover-qa",
  "cover_qa_output": "cover/cover_qa.json",
  "writer_allowed_sources": [
    "shared/writer-master-prompt.md",
    "research-notes.md",
    "title-brief.json",
    "published-titles-only.md",
    "shared/dzen-content-rules.md",
    "shared/dzen-news-casus.md",
    "shared/rf-blocked-entities.json"
  ],
  "writer_is_final": false,
  "writer_writes_opening": true,
  "writer_output": "drafts/writer.html",
  "writer_forbidden_sources": [
    "memory/blog/articles/*/article.html",
    "published site articles (live pages — old site text is a bad exemplar)",
    "memory/topics/",
    "memory/topics/blog-topics.md",
    "memory/content-lessons.md",
    "shared/golden-benchmark",
    "QA reports",
    "neighbor research-notes as prose exemplars"
  ],
  "sol_agent": "excalibur-blog-sol",
  "sol_is_final": true,
  "sol_output": "article.html",
  "sol_allowed_sources": [
    "shared/SOUL.md",
    "shared/soul-examples/SOURCE.md",
    "shared/soul-examples/post-to-article.md",
    "shared/soul-examples/good-outputs.md",
    "shared/soul-examples/bad-outputs.md",
    "shared/article-style.md",
    "shared/dzen-news-casus.md",
    "drafts/writer.html",
    "title-brief.json",
    "research-notes.md"
  ],
  "sol_forbidden_sources": [
    "memory/blog/articles/*/article.html (neighbors)",
    "published site articles",
    "memory/topics/",
    "memory/content-lessons.md",
    "Foreign channel posts as style exemplars (use only tenant SOUL examples)"
  ],
  "required_article_meta": {
    "pipeline_canon": "human-first-v2",
    "editorial_swarm": false
  },
  "forbidden_article_files": [
    "critic-skip.json",
    "critic-report.json",
    "critic-report-gate.json",
    "glavred-skip.json",
    "glavred-gate.json",
    "reader-panel-gate.json",
    "reader-sim-report.json",
    "reader-sim-gate.json",
    "novice-walkthrough.json",
    "novice-dry-run-report.json",
    "visual-qa-skip.json",
    "visual-qa-report.json",
    "thesis-brief.json",
    "thesis-brief-gate.json",
    "headline-board.json",
    "headline-board-gate.json",
    "anti-template-notes.json",
    "anti-template-report.json",
    "human-voice-lint.json",
    "utility-lint-report.json"
  ],
  "forbidden_body_markers": [
    "day-1",
    "day one",
    "day 1",
    "first win",
    "quick win"
  ],
  "forbidden_title_markers": [
    "без копипаста за вечер",
    "без копипаста",
    "за один вечер",
    "за вечер",
    "группа без копипаста",
    "канал без копипаста",
    "полный гайд",
    "чеклист",
    "7 шагов",
    "стоит ли покупать",
    "как купить без риелтора",
    "что такое",
    "и как"
  ],
  "opening_rules": {
    "block_first": true,
    "writer_owns_opening": false,
    "sol_owns_opening": true,
    "no_term_dump": true,
    "no_research_brief": true,
    "no_api_calque_styk": true,
    "no_tldr_opening": true,
    "no_fast_insight_block": true,
    "no_opening_bullet_lists": true,
    "prose_lead_sentences_min": 4,
    "prose_lead_sentences_max": 6,
    "style": "shared/article-style.md",
    "soul": "shared/SOUL.md",
    "soul_examples": "shared/soul-examples/",
    "gate": "scripts/excalibur_blog_opening_meta_gate.py"
  },
  "h1_rules": {
    "no_series_templates": true,
    "max_len": 70,
    "style": "shared/article-style.md",
    "soul": "shared/SOUL.md"
  },
  "quality_bar_9": {
    "contract": "shared/quality-bar-9.md",
    "gate": "scripts/excalibur_blog_quality_bar_9_gate.py",
    "output": "quality-bar-9.json",
    "word_count_min": 2000,
    "word_count_max": 2600,
    "dzen_engagement_goal": "likes_comments_subscriptions",
    "comment_magnet_required": true,
    "required_before_publish": true
  },
  "owner_lock_permanent": {
    "status": "LOCKED_ON_MAIN",
    "note": "Owner mandate — permanent canon, not chat memory. Do not weaken without explicit owner override.",
    "pillars": {
      "engagement_bomb": {
        "dzen_goal": "likes_comments_subscriptions",
        "shape": "news_casus_aktualochka",
        "opening": "prose_lead_4_6_sentences",
        "forbidden_opening": ["TL;DR", "Быстрый инсайт", "opening_bullet_lists", "how_to_checklist_lead"],
        "early_cta": "TG_and_MAX_only_after_prose_lead",
        "comment_magnet": true,
        "docs": ["shared/dzen-news-casus.md", "shared/SOUL.md", "shared/quality-bar-9.md"]
      },
      "meme_canon_v1": {
        "catalog": "memory/cover/meme-top100.json",
        "variety": "people_plus_cats_not_cats_only",
        "on_topic_funny": true,
        "sticker_max_frame_share": 0.15,
        "sacred_never_cover": ["hook_title", "host_face", "phone_cta"],
        "clearance_px": 80,
        "anti_repeat_days": 14,
        "anti_repeat_log": "memory/cover/used-motifs.json",
        "manifest_field": "meme_picks",
        "docs": ["memory/cover/cover-canon.json", "skills/cover-text-excalibur-blog/SKILL.md"]
      },
      "cover_fail_fast": {
        "max_full_attempts": 2,
        "env_override": "EXCALIBUR_COVER_MAX_ATTEMPTS",
        "timebox_minutes": "15-20",
        "exhausted_report": "cover/cover-budget-result.json",
        "after_budget": "Indexer_not_infinite_cover_qa_loop",
        "fixer_max_rounds": 2,
        "short_hook_words": "5-7_cyrillic",
        "ocr_escape": "apply_ocr_false_positive_escape_without_pil_kie",
        "forbidden": ["Kie", "PIL_mashup", "infinite_cover_qa_loop", "image_model_vip_tier"],
        "model": "grsai_standard_only",
        "script": "scripts/excalibur_blog_grsai_solo_cover.py",
        "docs": ["memory/cover/cover-canon.json", "skills/cover-excalibur-blog/SKILL.md"]
      }
    }
  }
}
