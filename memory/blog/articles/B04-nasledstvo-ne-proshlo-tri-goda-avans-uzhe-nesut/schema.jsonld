      "mainEntity": [
        {
          "@type": "Question",
          "name": "Достаточно ли одного собственника в выписке ЕГРН?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли верить словам «он отказался от наследства»?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет."
          }
        },
        {
          "@type": "Question",
          "name": "Если прошло больше шести месяцев после смерти, наследник уже не может претендовать?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Может."
          }
        },
        {
          "@type": "Question",
          "name": "Зачем запрос в реестр наследственных дел?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Реестр ФНП показывает, открывалось ли наследственное дело, у какого нотариуса и в отношении кого."
          }
        },
        {
          "@type": "Question",
          "name": "Что делать, если риелтор торопит с авансом?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Зафиксируйте чеклист документов письменно (мессенджер или e-mail). Запросите отказы и справки до передачи денег."
