            },
            "headline": "\u0412 \u0422\u044e\u043c\u0435\u043d\u0438 \u043f\u0435\u0440\u0435\u0434 \u0414\u0414\u0423 \u043f\u043e\u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u0438 290 \u0442\u044b\u0441\u044f\u0447 \u0437\u0430 \u043e\u0442\u0434\u0435\u043b\u043a\u0443 \u2014 \u0441\u0434\u0435\u043b\u043a\u0430 \u0432\u0441\u0442\u0430\u043b\u0430",
            "description": "\u0421\u0435\u043c\u044c\u044f \u0432 \u0422\u044e\u043c\u0435\u043d\u0438 \u0443\u0436\u0435 \u0433\u043e\u0442\u043e\u0432\u0438\u043b\u0430\u0441\u044c \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u0442\u044c \u0414\u0414\u0423 \u0438 \u043f\u0435\u0440\u0435\u0432\u0435\u0441\u0442\u0438 \u0434\u0435\u043d\u044c\u0433\u0438 \u043d\u0430 \u044d\u0441\u043a\u0440\u043e\u0443, \u043d\u043e \u043f\u0435\u0440\u0435\u0434 \u0441\u0434\u0435\u043b\u043a\u043e\u0439 \u0435\u0439 \u043f\u0440\u0435\u0434\u044a\u044f\u0432\u0438\u043b\u0438 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0439 \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043a\u0430\u0442 \u043d\u0430 \u043e\u0442\u0434\u0435\u043b\u043a\u0443 \u0437\u0430 290 \u0442\u044b\u0441\u044f\u0447 \u0440\u0443\u0431\u043b\u0435\u0439. \u0420\u0430\u0437\u0431\u0438\u0440\u0430\u044e, \u043f\u043e\u0447\u0435\u043c\u0443 \u0440\u0435\u043a\u043b\u0430\u043c\u0443, \u043a\u043e\u043c\u043c\u0435\u0440\u0447\u0435\u0441\u043a\u043e\u0435 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 \u043f\u0440\u043e\u0435\u043a\u0442 \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0430 \u043d\u0443\u0436\u043d\u043e \u0441\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0434\u043e \u043f\u043e\u0434\u043f\u0438\u0441\u0438 \u0438 \u043e\u043f\u043b\u0430\u0442\u044b.",
