      "@id": "{{SITE_BASE}}/blog/vtorichka-i-riski/avans-bankrotstvo-prodavtsa-ostanovilo-registratsiyu-tyumen/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Остановит ли банкротство продавца регистрацию после аванса?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Если в отношении продавца возбуждено дело о банкротстве до регистрации перехода права, Росреестр может приостановить регистрацию. Аванс сам по себе не даёт права собственности."
          }
        },
        {
          "@type": "Question",
          "name": "Достаточно ли чистой выписки ЕГРН перед авансом?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Выписка показывает обременения на квартиру, но не долги продавца. Нужны Федресурс, ФССП и проверка финансового состояния до передачи денег."
          }
        }
      ]
