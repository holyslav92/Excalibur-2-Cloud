            },
            "headline": "\u041a\u043b\u0430\u0434\u043e\u0432\u0443\u044e \u00ab\u0432 \u043f\u043e\u0434\u0430\u0440\u043e\u043a\u00bb \u0432 \u0422\u044e\u043c\u0435\u043d\u0438 \u0437\u0430 4 \u0434\u043d\u044f \u0434\u043e \u044d\u0441\u043a\u0440\u043e\u0443 \u0432\u044b\u043d\u0435\u0441\u043b\u0438 \u0432 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0439 \u0414\u0414\u0423 \u2014 \u0441\u0435\u043c\u044c\u044f \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0430 \u0441\u0434\u0435\u043b\u043a\u0443",
            "description": "\u0412 \u0422\u044e\u043c\u0435\u043d\u0438 \u043e\u0431\u0435\u0449\u0430\u043d\u043d\u044b\u0439 \u0431\u043e\u043d\u0443\u0441 \u0438\u0441\u0447\u0435\u0437 \u0438\u0437 \u043f\u0440\u043e\u0435\u043a\u0442\u0430 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0433\u043e \u0414\u0414\u0423 \u0437\u0430 \u0447\u0435\u0442\u044b\u0440\u0435 \u0434\u043d\u044f \u0434\u043e \u044d\u0441\u043a\u0440\u043e\u0443: \u043a\u043b\u0430\u0434\u043e\u0432\u0443\u044e \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b\u0438 \u043e\u0444\u043e\u0440\u043c\u0438\u0442\u044c \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u043c \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u043e\u043c. \u0421\u0432\u044f\u0442\u043e\u0441\u043b\u0430\u0432 \u0428\u0430\u043a\u0438\u043d \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0435\u0442, \u0433\u0434\u0435 \u0441\u0435\u043c\u044c\u044f \u0432\u043e\u0432\u0440\u0435\u043c\u044f \u043d\u0430\u0436\u0430\u043b\u0430 \u043d\u0430 \u043f\u0430\u0443\u0437\u0443.",
