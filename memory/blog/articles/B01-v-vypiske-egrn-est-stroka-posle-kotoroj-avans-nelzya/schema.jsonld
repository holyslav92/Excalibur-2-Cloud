    {
      "@type": "FAQPage",
      "@id": "{{SITE_BASE}}/v-vypiske-egrn-est-stroka-posle-kotoroj-avans-nelzya/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Продавец сам принёс выписку. Этого достаточно?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Выписку заказываете вы, за свои деньги, на свою почту — это самая дешёвая часть сделки."
          }
        },
        {
          "@type": "Question",
          "name": "А если выписка месячной давности?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Тогда это документ о прошлом месяце. Берите новую перед авансом и ещё раз перед подписанием."
          }
        },
        {
          "@type": "Question",
          "name": "Агент продавца говорит, что всё чистое. Верить?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Верить — да. Проверять — тоже да. Агент продавца работает на продавца."
          }
        },
        {
          "@type": "Question",
          "name": "Аванс уже отдан, а в выписке нашлось лишнее. Что делать?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Поднять договор аванса, зафиксировать переписку, начать разговор с продавцом на конкретике как можно раньше."
          }
        },
        {
          "@type": "Question",
          "name": "С обременением покупать вообще нельзя?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Можно, если вы знаете об обременении до денег и выстраиваете сделку под эту вводную."
          }
        }
      ]
    }
  ]
