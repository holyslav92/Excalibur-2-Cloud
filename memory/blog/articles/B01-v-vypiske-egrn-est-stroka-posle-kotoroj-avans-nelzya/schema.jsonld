    {
      "@type": "FAQPage",
      "@id": "{{SITE_BASE}}/v-vypiske-egrn-est-stroka-posle-kotoroj-avans-nelzya/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Достаточно ли краткой справки из ЕГРН?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. До аванса нужна полная выписка об основных характеристиках и зарегистрированных правах — с разделом 2 и реквизитом 4."
          }
        },
        {
          "@type": "Question",
          "name": "Что значит «не зарегистрировано» в реквизите 4?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Это официальная формулировка Росреестра: обременений на объект нет. Это не повод спешить с авансом без проверки истории прав и продавца."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли внести аванс, если в выписке ипотека?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ипотека — не безусловный стоп, но аванс только после письменного согласия банка или подтверждённой схемы погашения и переоформления."
          }
        },
        {
          "@type": "Question",
          "name": "Кто снимает запрет «без личного участия собственника»?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Только сам собственник лично — через МФЦ, Росреестр или Госуслуги. После снятия нужна новая выписка без этой строки."
          }
        },
        {
          "@type": "Question",
          "name": "Почему нельзя ориентироваться на слова «выписка чистая»?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Потому что «чистая» без расшифровки реквизита 4 ничего не значит. Продавец может искренне забыть о своём запрете, а риелтор продавца не обязан объяснять каждую строку — он отвечает только на заданные вопросы."
          }
        }
      ]
    }
  ]
